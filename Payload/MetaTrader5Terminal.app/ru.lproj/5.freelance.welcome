        <source srcset="https://c.mql5.com/external/emails/mt5/v2/dark/5.freelance-ru.jpg" media="(prefers-color-scheme: dark)" />
        <img width="620" height="348" alt="Freelance" src="https://c.mql5.com/external/emails/mt5/v2/5.freelance-ru.jpg" />
    </picture>
      </a>
      <br />
      <br />
      <div class="buttons">
        <a href="https://www.mql5.com/ru/job?utm_source=mt5terminal&utm_medium=special&utm_campaign=ru.mail.freelance" target="_blank" class="button">Перейти на Фриланс</a>
