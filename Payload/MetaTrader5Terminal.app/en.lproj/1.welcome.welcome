rk">@media (prefers-color-scheme: dark){body{color:#D6D6D6}a{color:#1E90FF}.link{border-color:#444444}.link:hover{border-color:#1E90FF}.link__text{color:#808080}.link__name{color:#D6D6D6}}</style>
